---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Whoami from "../components/Whoami.astro";
import About from "../components/About.astro";
import Now from "../components/Now.astro";
import Projects from "../components/Projects.astro";
import Stack from "../components/Stack.astro";
import Contributions from "../components/Contributions.astro";
import Socials from "../components/Socials.astro";
import StatusLine from "../components/StatusLine.astro";
---

<Layout title="andy hsu — full-stack developer">
  <a id="top"></a>
  <TopBar />

  <main class="mx-auto max-w-3xl px-4 sm:px-6 pb-4 sm:pb-6">
    <div class="rise" style="animation-delay: 20ms;">
      <Whoami />
    </div>

    <div class="rise" style="animation-delay: 120ms;">
      <About />
    </div>

    <div class="rise" style="animation-delay: 200ms;">
      <Now />
    </div>

    <div class="rise" style="animation-delay: 280ms;">
      <Projects />
    </div>

    <div class="rise" style="animation-delay: 360ms;">
      <Contributions />
    </div>

    <div class="rise" style="animation-delay: 440ms;">
      <Stack />
    </div>

    <div class="rise" style="animation-delay: 520ms;">
      <Socials />
    </div>

    <StatusLine />
  </main>

  {/* Floating Ko-fi widget — kept, but moved further from edge to avoid clashing with status line. */}
  <style is:inline>
    .floatingchat-container-wrap,
    .floating-chat-kofi-popup-iframe {
      right: 16px;
      bottom: 56px !important;
      left: unset;
    }
  </style>
  <script
    is:inline
    src="https://storage.ko-fi.com/cdn/scripts/overlay-widget.js"></script>
  <script>
    // @ts-ignore - global injected by ko-fi script
    kofiWidgetOverlay.draw("xhofe", {
      type: "floating-chat",
      "floating-chat.donateButton.text": "Support",
      "floating-chat.donateButton.background-color": "#a3e635",
      "floating-chat.donateButton.text-color": "#0b0d0e",
    });
  </script>
</Layout>
