---
import Layout from "../layouts/Layout.astro";
import StyleDock from "../components/StyleDock.astro";
import { site } from "../data/site";

const modules = import.meta.glob<Record<string, unknown>>("../styles/*/index.astro", { eager: true });
const styles = Object.entries(modules).map(([path, mod]) => ({
  id: path.split("/").filter(Boolean).at(-2) ?? "",
  Component: mod.default as (props: Record<string, never>) => unknown,
}));
---

<Layout title={site.title} description={site.description}>
  <StyleDock />
  {
    styles.map(({ id, Component }) => (
      <div data-style-root={id}>
        <Component />
      </div>
    ))
  }
</Layout>

<script>
  import { boot } from "../styles/boot";
  boot();
</script>
