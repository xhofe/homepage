---
import { projectName, roleLine, site, skillSrc, snakeSrc, year } from "../../data/site";
const y = year();
const panel = "h-full w-screen shrink-0 snap-start overflow-hidden px-8 pt-20 pb-8";
---

<div class="h-screen overflow-hidden bg-[#07070d] text-neutral-100">
<div data-scroll class="flex h-full snap-x snap-mandatory overflow-x-auto overflow-y-hidden overscroll-none">
  <section class={`${panel} flex flex-col justify-center`}>
    <p class="text-sm tracking-[0.2em] text-[#d6ff3f] uppercase">{site.availability}</p>
    <h1 class="mt-3 max-w-4xl text-[clamp(4rem,12vw,8rem)] leading-[0.9] font-extrabold tracking-tighter">{site.name}</h1>
    <p class="mt-6 max-w-xl text-xl leading-relaxed">{roleLine()}</p>
    <p class="mt-3 max-w-xl text-xl leading-relaxed">{site.quoteLead} <strong class="text-[#d6ff3f]">{site.quoteEm}</strong>.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      {
        site.socials.map((item) => (
          <a class="inline-flex items-center gap-1.5 border border-white/15 px-3 py-2 no-underline hover:border-[#d6ff3f] hover:text-[#d6ff3f]" href={item.link} target={item.link.startsWith("mailto:") ? undefined : "_blank"} rel={item.link.startsWith("mailto:") ? undefined : "noopener"}>
            <span class={item.icon} aria-hidden="true"></span>
            {item.text ? <span>{item.text}</span> : null}
          </a>
        ))
      }
    </div>
  </section>
  <section class={`${panel} flex items-center`}>
    <img class="max-h-[70vh] w-full object-contain" src={snakeSrc(true)} alt={site.labels.contributions} loading="lazy" />
  </section>
  <section class={panel}>
    <h2 class="mb-4 text-xs tracking-[0.2em] text-[#d6ff3f] uppercase">{site.labels.projects}</h2>
    <ul class="grid list-none grid-cols-2 gap-x-8 p-0">
      {
        site.projects.map((project) => (
          <li>
            <a class="grid grid-cols-[auto_1fr] items-baseline gap-3 border-b border-white/10 py-1.5 no-underline" href={`https://github.com/${project.repo}`} target="_blank" rel="noopener">
              <span class={project.icon} aria-hidden="true"></span>
              <span>
                <strong class="text-lg">{projectName(project.repo)}</strong>
                <span class="mt-1 line-clamp-2 block text-sm text-neutral-400">{project.desc}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section class={`${panel} flex flex-col justify-between`}>
    <div>
      <h2 class="mb-4 text-xs tracking-[0.2em] text-[#d6ff3f] uppercase">{site.labels.skills} · {site.skills.length} {site.labels.stacks}</h2>
      <img class="max-h-[55vh] w-full object-contain object-left-top" src={skillSrc(true)} alt={site.labels.techStack} loading="lazy" />
    </div>
    <footer class="mt-8 flex justify-between text-sm text-neutral-400">
      <span>© {y} {site.name}</span>
      <a class="js-top text-[#d6ff3f] no-underline" href="#top">{site.labels.backToTop}</a>
    </footer>
  </section>
</div>
</div>
<script>
  const scroller = document.querySelector<HTMLElement>('[data-style-root="strip"] [data-scroll]')
  if (scroller) {
    const active = () => document.documentElement.dataset.style === "strip"
    const lock = () => {
      document.documentElement.classList.toggle("overflow-hidden", active())
      document.body.classList.toggle("overflow-hidden", active())
    }
    window.addEventListener("wheel", (event) => {
      if (!active() || event.ctrlKey) return
      const target = event.target
      if (target instanceof Element && target.closest("#style-menu, #style-toggle, #theme-toggle")) return
      event.preventDefault()
      scroller.scrollBy({ left: Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY })
    }, { passive: false })
    new MutationObserver(lock).observe(document.documentElement, { attributes: true, attributeFilter: ["data-style"] })
    lock()
  }
</script>
