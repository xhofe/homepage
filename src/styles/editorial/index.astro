---
import { projectName, roleLine, site, skillSrc, snakeSrc, year } from "../../data/site";
const y = year();
---

<div class="grid min-h-screen grid-cols-1 bg-[#f3ecdf] text-[#1d1915] md:grid-cols-[280px_1fr]">
  <aside class="border-b border-[#e2d5c3] bg-[#efe6d6] px-6 pt-20 pb-8 md:sticky md:top-0 md:h-screen md:overflow-auto md:border-r md:border-b-0">
    <img class="size-18 rounded-full" src={site.avatar} alt={site.name} />
    <p class="mt-5 text-xs tracking-[0.14em] text-[#8c3a2f] uppercase">{site.availability}</p>
    <h1 class="mt-1 font-serif text-4xl font-medium tracking-tight">{site.name}</h1>
    <p class="mt-3 leading-normal">{roleLine()}</p>
    <div class="mt-6 flex flex-col items-start gap-2">
      {
        site.socials.map((item) => (
          <a class="inline-flex items-center gap-1.5 no-underline hover:text-[#8c3a2f]" href={item.link} target={item.link.startsWith("mailto:") ? undefined : "_blank"} rel={item.link.startsWith("mailto:") ? undefined : "noopener"}>
            <span class={item.icon} aria-hidden="true"></span>
            {item.text ? <span>{item.text}</span> : null}
          </a>
        ))
      }
    </div>
  </aside>
  <article class="px-5 pt-10 pb-12 md:px-12 md:pt-20">
    <p class="font-serif text-3xl leading-snug md:text-4xl">{site.quoteLead} <em class="text-[#8c3a2f]">{site.quoteEm}</em>.</p>
    <img class="my-8 w-full" src={snakeSrc(false)} alt={site.labels.contributions} loading="lazy" />
    <h2 class="mb-4 font-serif text-2xl font-medium">{site.labels.projects}</h2>
    <ol class="list-none p-0">
      {
        site.projects.map((project, index) => (
          <li>
            <a class="grid grid-cols-[auto_auto_1fr] items-baseline gap-3 border-t border-[#e2d5c3] py-3.5 no-underline" href={`https://github.com/${project.repo}`} target="_blank" rel="noopener">
              <span class="font-serif text-[#8c3a2f]">{String(index + 1).padStart(2, "0")}</span>
              <span class={project.icon} aria-hidden="true"></span>
              <span>
                <strong>{projectName(project.repo)}</strong>
                <small class="mt-1 block text-[#6b6258] leading-snug">{project.desc}</small>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <h2 class="mt-8 mb-3 font-serif text-2xl font-medium">{site.labels.skills} <span class="font-sans text-xs text-[#6b6258]">{site.skills.length} {site.labels.stacks}</span></h2>
    <img class="w-full" src={skillSrc(false)} alt={site.labels.techStack} loading="lazy" />
    <footer class="mt-12 flex justify-between border-t border-[#e2d5c3] pt-4 text-sm text-[#6b6258]">
      <span>© {y} {site.name}</span>
      <a class="js-top no-underline" href="#top">{site.labels.backToTop}</a>
    </footer>
  </article>
</div>
