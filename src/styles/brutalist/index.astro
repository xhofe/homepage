---
import { projectName, roleLine, site, skillSrc, snakeSrc, year } from "../../data/site";
const y = year();
---

<div class="min-h-screen border-x-4 border-black bg-white text-[#111]">
  <header class="border-t-4 border-black px-5 py-6">
    <p class="inline-block bg-[#ff3b00] px-1.5 py-0.5 text-xs font-extrabold tracking-widest text-white uppercase">{site.availability}</p>
    <h1 class="mt-3 text-[clamp(3.2rem,12vw,7rem)] leading-[0.9] font-extrabold tracking-tighter uppercase">{site.name}</h1>
    <p class="mt-4 max-w-xl text-lg leading-snug">{roleLine()}</p>
    <p class="mt-3 max-w-xl text-lg leading-snug">{site.quoteLead} <strong>{site.quoteEm}</strong>.</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {
        site.socials.map((item) => (
          <a class="inline-flex items-center gap-1.5 border-[3px] border-black px-2.5 py-1.5 font-bold no-underline hover:bg-black hover:text-white" href={item.link} target={item.link.startsWith("mailto:") ? undefined : "_blank"} rel={item.link.startsWith("mailto:") ? undefined : "noopener"}>
            <span class={item.icon} aria-hidden="true"></span>
            {item.text ? <span>{item.text}</span> : null}
          </a>
        ))
      }
    </div>
  </header>
  <section class="border-t-4 border-black px-5 py-5">
    <img class="w-full" src={snakeSrc(false)} alt={site.labels.contributions} loading="lazy" />
  </section>
  <section class="border-t-4 border-black px-5 py-5">
    <h2 class="mb-3 text-4xl font-extrabold tracking-tight uppercase">{site.labels.projects}</h2>
    {
      site.projects.map((project) => (
        <a class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-1 border-t-[3px] border-black py-3.5 no-underline hover:bg-[#ff3b00] hover:text-white sm:grid-cols-[auto_12rem_1fr]" href={`https://github.com/${project.repo}`} target="_blank" rel="noopener">
          <span class={project.icon} aria-hidden="true"></span>
          <strong>{projectName(project.repo)}</strong>
          <span class="col-span-2 sm:col-span-1">{project.desc}</span>
        </a>
      ))
    }
  </section>
  <section class="border-t-4 border-black px-5 py-5">
    <h2 class="mb-3 text-4xl font-extrabold tracking-tight uppercase">{site.labels.skills} <small class="text-sm font-semibold">{site.skills.length} {site.labels.stacks}</small></h2>
    <img class="w-full" src={skillSrc(false)} alt={site.labels.techStack} loading="lazy" />
  </section>
  <footer class="flex justify-between border-t-4 border-black px-5 py-4 font-extrabold uppercase">
    <span>© {y} {site.name}</span>
    <a class="js-top no-underline" href="#top">{site.labels.backToTop}</a>
  </footer>
</div>
