---
export interface Props {
  repo: string;
  desc: string;
  icon?: string;
}

const { icon, repo, desc } = Astro.props;
const name = repo.split("/")[1];
---

<a
  class="project-card group block px-4 py-3.5 rounded-xl decoration-none text-current transition-all duration-300"
  href={`https://github.com/${repo}`}
  target="_blank"
  rel="noopener"
>
  <div class="flex h-full items-center justify-center">
    <div flex-1 flex="~ col gap-1" min-w-0>
      <div class="flex items-center justify-between gap-2 font-semibold leading-relaxed">
        <span class="truncate">{name}</span>
        <span
          class="i-ri-arrow-right-up-line text-base opacity-0 -translate-x-1 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0"
        ></span>
      </div>
      <div op-60 font-normal text-sm leading-snug>
        {desc}
      </div>
    </div>
    {icon && (
      <div ml-4 text-3xl op-90 class="shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6">
        <div class={icon}></div>
      </div>
    )}
  </div>
</a>

<style>
  .project-card {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  :global(html.dark) .project-card {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: none;
  }
  .project-card:hover {
    transform: translateY(-2px);
    border-color: rgba(124, 92, 255, 0.4);
    box-shadow: 0 12px 30px -12px rgba(124, 92, 255, 0.35);
  }
  :global(html.dark) .project-card:hover {
    border-color: rgba(156, 132, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 12px 30px -10px rgba(124, 92, 255, 0.45);
  }
</style>
