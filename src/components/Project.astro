---
export interface Props {
  repo: string;
  desc: string;
  /** Two-letter tag, like "go", "ts", "rs", "ext". Renders as a small monochrome chip. */
  tag?: string;
  /** Optional small label (e.g. "★", "pinned"). */
  badge?: string;
}

const { repo, desc, tag, badge } = Astro.props;
const name = repo.split("/")[1];
const owner = repo.split("/")[0];
---

<a
  class="proj-row group"
  href={`https://github.com/${repo}`}
  target="_blank"
  rel="noopener"
>
  {/* drwxr-xr-x – purely decorative permission bits, terminal style */}
  <span class="perm" aria-hidden="true">drwxr-xr-x</span>

  <span class="tag" data-tag={tag || "—"}>{tag || "—"}</span>

  <span class="name">
    <span class="owner">{owner}/</span><span class="repo">{name}</span>
    {badge && <span class="badge">{badge}</span>}
  </span>

  <span class="desc">{desc}</span>

  <span class="arrow i-ri-arrow-right-up-line" aria-hidden="true"></span>
</a>

<style>
  .proj-row {
    display: grid;
    grid-template-columns: auto 2.6rem 1fr 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-top: 1px dashed rgb(var(--line));
    color: inherit;
    text-decoration: none;
    font-size: 0.88rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .proj-row:first-child {
    border-top: 0;
  }
  .proj-row:hover {
    background: rgb(var(--accent) / 0.06);
  }

  .perm {
    color: rgb(var(--muted));
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    display: none;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.4rem;
    padding: 0 6px;
    border: 1px solid rgb(var(--line));
    color: rgb(var(--muted));
    font-size: 0.7rem;
    text-transform: lowercase;
    letter-spacing: 0.04em;
  }
  .proj-row:hover .tag {
    color: rgb(var(--accent));
    border-color: rgb(var(--accent) / 0.5);
  }

  .name {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
    color: rgb(var(--fg));
    font-weight: 600;
  }
  .name .owner {
    color: rgb(var(--muted));
    font-weight: 400;
  }
  .name .repo {
    text-decoration: none;
  }
  .proj-row:hover .name .repo {
    color: rgb(var(--accent));
  }

  .badge {
    margin-left: 4px;
    font-size: 0.7rem;
    color: rgb(var(--warn));
    border: 1px solid rgb(var(--warn) / 0.4);
    padding: 0 5px;
    line-height: 1.4;
    font-weight: 500;
  }

  .desc {
    color: rgb(var(--fg) / 0.7);
    font-size: 0.82rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    color: rgb(var(--muted));
    opacity: 0;
    transform: translateX(-4px);
    transition: transform 0.2s ease, opacity 0.2s ease, color 0.2s ease;
  }
  .proj-row:hover .arrow {
    opacity: 1;
    transform: translateX(0);
    color: rgb(var(--accent));
  }

  /* On wider screens reveal the perm column for the full ls -la look. */
  @media (min-width: 768px) {
    .proj-row {
      grid-template-columns: 8.5rem 2.6rem 1.1fr 1.6fr auto;
    }
    .perm {
      display: inline;
    }
  }

  /* Mobile: stack desc below name. */
  @media (max-width: 520px) {
    .proj-row {
      grid-template-columns: 2.6rem 1fr auto;
      grid-template-areas:
        "tag name arrow"
        ". desc desc";
    }
    .perm { display: none; }
    .tag { grid-area: tag; }
    .name { grid-area: name; }
    .desc { grid-area: desc; white-space: normal; font-size: 0.78rem; }
    .arrow { grid-area: arrow; }
  }
</style>
