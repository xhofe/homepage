---
import SectionHeader from "./SectionHeader.astro";

const socials = [
  { key: "github",    handle: "xhofe",                    link: "https://github.com/xhofe",                    icon: "i-ri-github-fill" },
  { key: "twitter",   handle: "@Xh0fe",                   link: "https://twitter.com/Xh0fe",                   icon: "i-ri-twitter-fill" },
  { key: "blog",      handle: "blog.nn.ci",               link: "https://blog.nn.ci",                          icon: "i-ri-book-2-line" },
  { key: "stackover", handle: "u/10545416",               link: "https://stackoverflow.com/users/10545416/xhofe", icon: "i-jam-stackoverflow" },
  { key: "bilibili",  handle: "uid 1520762073",           link: "https://space.bilibili.com/1520762073",       icon: "i-ri-bilibili-fill" },
  { key: "email",     handle: "i@nn.ci",                  link: "mailto:i@nn.ci",                              icon: "i-ri-mail-line" },
  { key: "sponsor",   handle: "github.com/sponsors/xhofe",link: "https://github.com/sponsors/xhofe",           icon: "i-ri-heart-3-line" },
];
---

<section>
  <SectionHeader cmd="contact --list" />

  <div class="contact-list border border-line bg-bg-elev/50">
    {socials.map((s) => (
      <a
        class="contact-row group"
        href={s.link}
        target={s.link.startsWith("mailto:") ? undefined : "_blank"}
        rel="noopener"
      >
        <span class={`icon ${s.icon}`}></span>
        <span class="key">{s.key}</span>
        <span class="dots" aria-hidden="true"></span>
        <span class="handle">{s.handle}</span>
        <span class="arrow i-ri-arrow-right-up-line" aria-hidden="true"></span>
      </a>
    ))}
  </div>
</section>

<style>
  .contact-list {
    padding: 4px 0;
  }
  .contact-row {
    display: grid;
    grid-template-columns: 1.4rem 6rem 1fr auto auto;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
    border-top: 1px dashed rgb(var(--line));
    color: inherit;
    text-decoration: none;
    font-size: 0.88rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .contact-row:first-child {
    border-top: 0;
  }
  .contact-row:hover {
    background: rgb(var(--accent) / 0.06);
  }

  .icon {
    color: rgb(var(--muted));
    transition: color 0.15s ease, transform 0.2s ease;
    font-size: 1rem;
  }
  .contact-row:hover .icon {
    color: rgb(var(--accent));
    transform: translateY(-1px);
  }

  .key {
    color: rgb(var(--accent));
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .dots {
    flex: 1;
    height: 1px;
    background-image: linear-gradient(to right, rgb(var(--line)) 0, rgb(var(--line)) 4px, transparent 4px);
    background-size: 8px 1px;
    background-repeat: repeat-x;
  }

  .handle {
    color: rgb(var(--fg) / 0.85);
    font-size: 0.85rem;
  }

  .arrow {
    color: rgb(var(--muted));
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }
  .contact-row:hover .arrow {
    opacity: 1;
    transform: translateX(0);
    color: rgb(var(--accent));
  }

  @media (max-width: 520px) {
    .contact-row {
      grid-template-columns: 1.4rem 1fr auto auto;
    }
    .dots { display: none; }
  }
</style>
