---
// Theme toggle with circular reveal via View Transitions API.
// Terminal-flavored: square button, monospace label, single accent.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  title="Toggle theme (t)"
  class="theme-toggle inline-flex items-center justify-center w-8 h-8 border border-fg/15 hover:border-accent transition-colors relative overflow-hidden"
>
  <span class="sr-only">Toggle theme</span>
  <span class="icon sun i-ri-sun-line"></span>
  <span class="icon moon i-ri-moon-clear-line"></span>
</button>

<style>
  .theme-toggle .icon {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 16px;
    height: 16px;
    display: inline-block;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      color 0.2s ease;
    will-change: transform, opacity;
  }
  /* Distinct default colors per icon — high contrast in both themes. */
  .theme-toggle .sun {
    color: rgb(var(--warn));
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }
  .theme-toggle .moon {
    color: rgb(var(--accent));
    transform: rotate(-90deg) scale(0.4);
    opacity: 0;
  }
  /* Hover unifies to the accent for consistent feedback. */
  .theme-toggle:hover .icon {
    color: rgb(var(--accent));
  }
  :global(html.dark) .theme-toggle .sun {
    transform: rotate(90deg) scale(0.4);
    opacity: 0;
  }
  :global(html.dark) .theme-toggle .moon {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }
</style>

<script>
  const STORAGE_KEY = 'theme';

  function applyTheme(theme: 'light' | 'dark') {
    const root = document.documentElement;
    if (theme === 'dark') root.classList.add('dark');
    else root.classList.remove('dark');
    root.dataset.theme = theme;
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {}
  }

  function getNextTheme(): 'light' | 'dark' {
    return document.documentElement.classList.contains('dark') ? 'light' : 'dark';
  }

  if ('startViewTransition' in document) {
    document.documentElement.classList.add('vt-supported');
  }

  function toggleTheme(event: MouseEvent | KeyboardEvent) {
    const next = getNextTheme();
    const isDark = next === 'dark';

    const target = event.currentTarget as HTMLElement | null;
    let x = 0;
    let y = 0;
    if (event instanceof MouseEvent) {
      x = event.clientX;
      y = event.clientY;
    }
    if (target && (x === 0 && y === 0)) {
      const rect = target.getBoundingClientRect();
      x = rect.left + rect.width / 2;
      y = rect.top + rect.height / 2;
    }

    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    );

    // @ts-ignore
    if (typeof document.startViewTransition !== 'function') {
      applyTheme(next);
      return;
    }

    // @ts-ignore
    const transition = document.startViewTransition(() => {
      applyTheme(next);
    });

    transition.ready.then(() => {
      const clipPath = [
        `circle(0px at ${x}px ${y}px)`,
        `circle(${endRadius}px at ${x}px ${y}px)`,
      ];
      document.documentElement.animate(
        {
          clipPath: isDark ? clipPath : [...clipPath].reverse(),
        },
        {
          duration: 480,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'forwards',
          pseudoElement: isDark
            ? '::view-transition-new(root)'
            : '::view-transition-old(root)',
        }
      );
    });
  }

  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', toggleTheme as EventListener);

  // Keyboard shortcut: `t` toggles theme.
  document.addEventListener('keydown', (e) => {
    if (e.key === 't' && !e.metaKey && !e.ctrlKey && !e.altKey) {
      const tag = (document.activeElement?.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      toggleTheme(e);
    }
  });

  // React to system theme changes when user hasn't explicitly chosen.
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  media.addEventListener?.('change', (e) => {
    if (!localStorage.getItem(STORAGE_KEY)) {
      applyTheme(e.matches ? 'dark' : 'light');
    }
  });
</script>
