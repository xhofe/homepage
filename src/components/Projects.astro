---
import Project from "./Project.astro";
import SectionHeader from "./SectionHeader.astro";

const projects = [
  {
    repo: "alist-org/alist",
    desc: "A file list program supporting multiple cloud storages.",
    tag: "go",
    badge: "★",
  },
  {
    repo: "alist-org/alist-web",
    desc: "Front end of Alist V3, built with SolidJS.",
    tag: "ts",
  },
  {
    repo: "xhofe/gh-contributors",
    desc: "Generate SVG of contributors across multiple repos.",
    tag: "go",
  },
  {
    repo: "xhofe/solid-contextmenu",
    desc: "Context menu primitives for SolidJS apps.",
    tag: "ts",
  },
  {
    repo: "xhofe/aper",
    desc: "A simple music player built with SolidJS and howler.js.",
    tag: "ts",
  },
  {
    repo: "xhofe/solid-iconify",
    desc: "Iconify icon component set for SolidJS.",
    tag: "ts",
  },
  {
    repo: "xhofe/ipa-renamer",
    desc: "Command-line tool for renaming .ipa files quickly.",
    tag: "rs",
  },
  {
    repo: "xhofe/imgbed",
    desc: "Multi-interface image / file upload utility.",
    tag: "ts",
  },
  {
    repo: "xhofe/vscode-log-watcher",
    desc: "VS Code extension for watching log files in real time.",
    tag: "ext",
  },
  {
    repo: "xhofe/vscode-pb-jump",
    desc: "Jump between protobuf definitions and generated code.",
    tag: "ext",
  },
];
---

<section>
  <SectionHeader cmd="ls -la projects/" meta={`${projects.length} repos · all on github`} metaHref="https://github.com/xhofe?tab=repositories" />

  <div class="proj-list border border-line bg-bg-elev/50">
    {projects.map((project) => <Project {...project} />)}
  </div>

  <p class="mt-3 text-[0.78rem] text-muted">
    <span class="term-prompt">$</span> use <span class="kbd">↵</span> to open
    a repo · listing only highlighted projects, see all on
    <a class="link-inline" href="https://github.com/xhofe" target="_blank" rel="noopener">github.com/xhofe</a>.
  </p>
</section>

<style>
  .proj-list {
    /* Slight inner top padding so the first dashed border doesn't visually clash with the wrapper border. */
    padding: 0;
  }
</style>
