---
import { site } from "../data/site";
import { earlyScript } from "../styles/early";
import { getStyles, styleVisibilityCss } from "../styles/load";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const paint = earlyScript(getStyles());
const visibility = styleVisibilityCss();
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0f" />
    <link rel="icon" type="image/svg+xml" href={site.avatar} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Fragment set:html={`<style>${visibility}</style><script>${paint}</script>`} />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  html[data-scheme="light"],
  html[data-scheme="system"]:not(.dark) {
    background: #fafaf9;
    color: #121217;
    color-scheme: light;
  }
  html[data-scheme="dark"],
  html[data-scheme="system"].dark {
    background: #0a0a0f;
    color: #f0f0f5;
    color-scheme: dark;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
  ::view-transition-old(root) { z-index: 9999; }
  ::view-transition-new(root) { z-index: 1; }
  html.dark::view-transition-old(root) { z-index: 1; }
  html.dark::view-transition-new(root) { z-index: 9999; }
</style>
