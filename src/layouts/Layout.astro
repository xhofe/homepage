---
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Andy Hsu — Full Stack developer & open source enthusiast.",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0f" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="https://nn.ci/images/avatar.svg"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Anti-flicker: apply theme before first paint */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          }
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased text-neutral-900 dark:text-neutral-100">
    {/* Decorative background */}
    <div aria-hidden="true" class="bg-aurora">
      <div class="blob blob-a"></div>
      <div class="blob blob-b"></div>
      <div class="blob blob-c"></div>
      <div class="grid-overlay"></div>
    </div>

    <slot />
  </body>
</html>

<style is:global>
  :root {
    --accent: 124, 92, 255;
    --accent-2: 247, 108, 198;
    --bg: 250, 250, 249;
    --bg-elev: 255, 255, 255;
    --fg: 18, 18, 23;
    --muted: 100, 100, 110;
    --ring: 0, 0, 0;
    --accent-gradient: linear-gradient(
      120deg,
      rgb(var(--accent)),
      rgb(var(--accent-2)) 60%,
      #ffb37c 100%
    );
  }

  html.dark {
    --bg: 10, 10, 15;
    --bg-elev: 20, 20, 28;
    --fg: 240, 240, 245;
    --muted: 160, 160, 175;
    --ring: 255, 255, 255;
    --accent: 156, 132, 255;
    --accent-2: 255, 138, 210;
  }

  html,
  body {
    background-color: rgb(var(--bg));
    color: rgb(var(--fg));
  }

  /* Smooth color transitions when no View Transitions support */
  html:not(.vt-supported) body,
  html:not(.vt-supported) .surface,
  html:not(.vt-supported) .card-base {
    transition: background-color 0.4s ease, color 0.3s ease, border-color 0.3s ease;
  }

  /* Decorative aurora background */
  .bg-aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .bg-aurora .blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    opacity: 0.55;
    transition: opacity 0.6s ease, background 0.6s ease;
    will-change: transform;
  }
  .bg-aurora .blob-a {
    width: 540px;
    height: 540px;
    left: -160px;
    top: -160px;
    background: radial-gradient(circle at 30% 30%, #c4b5fd, transparent 60%);
    animation: float-a 18s ease-in-out infinite;
  }
  .bg-aurora .blob-b {
    width: 480px;
    height: 480px;
    right: -120px;
    top: 20%;
    background: radial-gradient(circle at 70% 30%, #fbcfe8, transparent 60%);
    animation: float-b 22s ease-in-out infinite;
  }
  .bg-aurora .blob-c {
    width: 420px;
    height: 420px;
    left: 30%;
    bottom: -160px;
    background: radial-gradient(circle at 50% 50%, #bae6fd, transparent 60%);
    animation: float-c 26s ease-in-out infinite;
  }
  html.dark .bg-aurora .blob {
    opacity: 0.35;
  }
  html.dark .bg-aurora .blob-a {
    background: radial-gradient(circle at 30% 30%, #6d4cff, transparent 60%);
  }
  html.dark .bg-aurora .blob-b {
    background: radial-gradient(circle at 70% 30%, #ff6dbf, transparent 60%);
  }
  html.dark .bg-aurora .blob-c {
    background: radial-gradient(circle at 50% 50%, #00b3ff, transparent 60%);
  }

  .bg-aurora .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.04) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(ellipse at center, black 50%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 50%, transparent 80%);
  }
  html.dark .bg-aurora .grid-overlay {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }

  @keyframes float-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, 30px) scale(1.08); }
  }
  @keyframes float-b {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-50px, 40px) scale(1.05); }
  }
  @keyframes float-c {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -40px) scale(1.07); }
  }

  /* Text gradient utility */
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Intro animations */
  @keyframes rise-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .rise {
    animation: rise-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  code {
    font-family: 'JetBrains Mono', Menlo, Monaco, monospace;
  }

  /* View Transitions: circular reveal for theme switch */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-old(root) {
    z-index: 1;
  }
  ::view-transition-new(root) {
    z-index: 9999;
  }
  html.dark::view-transition-old(root) {
    z-index: 9999;
  }
  html.dark::view-transition-new(root) {
    z-index: 1;
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .bg-aurora .blob { animation: none; }
  }
</style>
