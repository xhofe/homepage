---
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Andy Hsu — Full-stack developer & open source enthusiast.",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f4ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0d0e" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="https://nn.ci/images/avatar.svg"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Apply theme before first paint to avoid flicker. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          }
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-mono antialiased text-fg selection:bg-accent/30 selection:text-fg">
    {/* Subtle CRT-grid background — not a gradient blob. */}
    <div aria-hidden="true" class="bg-grid">
      <div class="grid-lines"></div>
      <div class="vignette"></div>
      <div class="scanlines"></div>
    </div>

    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Light: warm paper + ink, dark green accent for contrast on light bg. */
    --bg: 244, 244, 238;
    --bg-elev: 252, 252, 247;
    --fg: 14, 16, 17;
    --muted: 92, 97, 102;
    --line: 217, 217, 210;
    --accent: 63, 98, 18;   /* lime-800-ish, readable on paper */
    --warn: 180, 83, 9;     /* amber-700 */
  }

  html.dark {
    /* Dark: phosphor terminal. */
    --bg: 11, 13, 14;
    --bg-elev: 18, 20, 22;
    --fg: 232, 234, 234;
    --muted: 123, 131, 136;
    --line: 31, 34, 37;
    --accent: 163, 230, 53; /* lime-400 / phosphor green */
    --warn: 245, 158, 11;   /* amber-500 */
  }

  html,
  body {
    background-color: rgb(var(--bg));
    color: rgb(var(--fg));
    font-feature-settings: "ss01", "ss02", "cv01", "cv11";
  }

  /* Smooth color transitions when there's no View Transitions support. */
  html:not(.vt-supported) body {
    transition: background-color 0.35s ease, color 0.25s ease;
  }

  /* CRT-grid background — fixed, behind everything. */
  .bg-grid {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .bg-grid .grid-lines {
    position: absolute;
    inset: -1px;
    background-image:
      linear-gradient(to right, rgb(var(--line) / 0.55) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--line) / 0.55) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, #000 35%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, #000 35%, transparent 85%);
  }

  .bg-grid .vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgb(var(--accent) / 0.06), transparent 60%),
      radial-gradient(ellipse at 100% 100%, rgb(var(--accent) / 0.04), transparent 55%);
  }

  /* Faint scanlines — barely there, only in dark mode. */
  .bg-grid .scanlines {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.025) 0px,
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px,
      transparent 3px
    );
    mix-blend-mode: overlay;
    transition: opacity 0.4s ease;
  }
  html.dark .bg-grid .scanlines {
    opacity: 0.5;
  }

  /* Blinking cursor caret — used after the name in the hero. */
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    vertical-align: -0.12em;
    background: rgb(var(--accent));
    margin-left: 0.12em;
    animation: caret-blink 1.05s steps(1, end) infinite;
  }
  @keyframes caret-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* Rise-in entrance animation, kept subtler than before. */
  @keyframes rise-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .rise {
    animation: rise-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Underline-on-hover for inline links inside prose-ish areas. */
  .link-inline {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dashed rgb(var(--muted) / 0.6);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .link-inline:hover {
    color: rgb(var(--accent));
    border-bottom-color: rgb(var(--accent));
  }

  /* View Transitions: circular reveal for theme switch (kept from previous design). */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-old(root) { z-index: 9999; }
  ::view-transition-new(root) { z-index: 1; }
  html.dark::view-transition-old(root) { z-index: 1; }
  html.dark::view-transition-new(root) { z-index: 9999; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .caret { animation: none; opacity: 1; }
  }
</style>
